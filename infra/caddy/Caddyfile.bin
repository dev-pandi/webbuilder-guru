{
	email teknis@pandi.id
	acme_ca https://acme-v02.api.letsencrypt.org/directory

	on_demand_tls {
		ask "http://10.1.12.46:4011/internal/caddy/ask?secret=39d75c7a0e8e839b2a1c0a5015c8f36e7ecb0416388d21c3b855cb7c65c79954"
		interval 2m
		burst 5
	}
}

# ---------- HTTP global redirect ----------
# PENTING: `.well-known/acme-challenge/*` HARUS passthrough ke Caddy
# default handler supaya cert renewal + on-demand issuance tetap jalan.
# Tanpa exempt ini, HTTP-01 ACME challenge kena redirect ke HTTPS → fail.
:80 {
	@acme path /.well-known/acme-challenge/*
	handle @acme {
		# Caddy auto-handle ACME challenge di sini — tidak perlu reverse_proxy.
		# Biarkan default handler respond file challenge.
	}
	redir https://{host}{uri} 301
}

# ---------- Reusable snippets ----------
# Security headers BASE (strict) — dipakai dashboard + preview admin.
# Tidak include CSP di sini — tiap site override CSP sendiri sesuai kebutuhan
# (fonts.googleapis / iframe allowance / connect-src ke API spesifik).
(security_base) {
	header {
		-X-Powered-By
		-Server
		-X-AspNet-Version
		-X-AspNetMvc-Version

		# HSTS 1 tahun + preload — pastikan yakin HTTPS-only sebelum aktif
		# preload submit di hstspreload.org.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-XSS-Protection "1; mode=block"

		# Permissions-Policy — nonaktifkan fitur browser yang tidak dipakai
		# platform. Butuh fitur? tambah di site-spesifik override.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"

		# Cross-origin isolation — COOP + CORP same-origin. Boleh dilonggarkan
		# per site kalau butuh cross-origin resource (mis. CDN font).
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
	}
}

# ---------- Dashboard (kubaca.id) ----------
# Next.js app dashboard — butuh:
#   - Google Fonts (fonts.googleapis.com + fonts.gstatic.com) → style-src + font-src
#   - Inline script untuk Next.js RSC/ISR → script-src 'unsafe-inline'
#     (TODO: migrate ke nonce-based CSP untuk A+ murni)
#   - API calls ke api.kubaca.id → connect-src eksplisit
#   - Iframe preview tenant sites → embed tenant renderer. Tapi kita FRAMING-NYA
#     (dashboard frame tenant), bukan di-frame → frame-ancestors 'self' cukup
kubaca.id {
	tls /etc/caddy/ssl/kubaca.id/fullchain.pem /etc/caddy/ssl/kubaca.id/privkey.pem {
		protocols tls1.2 tls1.3
	}

	import security_base

	header {
		# CSP — allow Google Fonts + API same-domain
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.kubaca.id https://*.kubaca.id; frame-src 'self' https://*.kubaca.id https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
	}

	route {
		# ACME HTTP-01 di HTTPS block tidak lazim, tapi well-known file static OK.
		@wellknown path /.well-known/*
		handle @wellknown {
			root * /etc/caddy/well-known
			file_server
		}

		reverse_proxy 10.1.12.46:4000
	}

	log {
		output file /var/log/caddy/app-access.log {
			roll_size 100mb
			roll_keep 5
		}
	}
}

# ---------- API (api.kubaca.id) ----------
# JSON API — tidak serve HTML, CSP minimal.
# Response diakses cross-origin oleh dashboard kubaca.id + renderer → CORP must-be cross-origin.
# Vary: Origin diset otomatis oleh Fiber CORS middleware (bukan Caddy).
api.kubaca.id {
	tls /etc/caddy/ssl/kubaca.id/fullchain.pem /etc/caddy/ssl/kubaca.id/privkey.pem {
		protocols tls1.2 tls1.3
	}

	header {
		-X-Powered-By
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# API tidak serve HTML; CSP minimal cukup untuk observability score.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		# API harus bisa di-fetch cross-origin oleh dashboard + renderer.
		Cross-Origin-Resource-Policy "cross-origin"
		# Vary: Origin dibantu set CORS middleware di API Fiber — tidak perlu di Caddy.
	}

	reverse_proxy 10.1.12.46:4011 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		transport http {
			dial_timeout 5s
			response_header_timeout 60s
			read_timeout 120s
		}
	}

	request_body {
		max_size 20MB
	}

	log {
		output file /var/log/caddy/api-access.log {
			roll_size 100mb
			roll_keep 5
		}
	}
}

# ---------- Preview admin (preview.kubaca.id) ----------
# Dipakai iframe preview di dashboard admin + wizard template picker.
# WAJIB bisa di-iframe dari kubaca.id → frame-ancestors harus include dashboard origin.
# Konten = tenant Next.js renderer (sama binary) + butuh Google Fonts juga.
preview.kubaca.id {
	tls /etc/caddy/ssl/kubaca.id/fullchain.pem /etc/caddy/ssl/kubaca.id/privkey.pem {
		protocols tls1.2 tls1.3
	}

	import security_base

	header {
		# Override COOP — iframe cross-origin butuh unsafe-none supaya window.opener
		# tetap bisa dipakai dari parent dashboard (misal postMessage).
		Cross-Origin-Opener-Policy "unsafe-none"
		Cross-Origin-Resource-Policy "cross-origin"

		# CSP preview — allow Google Fonts + framing dari dashboard origin.
		# frame-ancestors eksplisit (tidak *) supaya hanya kubaca.id yang bisa embed.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.kubaca.id; frame-ancestors 'self' https://kubaca.id https://*.kubaca.id; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
	}

	reverse_proxy 10.1.12.46:4001 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}

		transport http {
			dial_timeout 5s
			response_header_timeout 60s
			read_timeout 120s
		}
	}

	log {
		output file /var/log/caddy/renderer-preview.log {
			roll_size 100mb
			roll_keep 5
		}
	}
}

# ---------- www redirect ----------
www.kubaca.id {
	tls /etc/caddy/ssl/kubaca.id/fullchain.pem /etc/caddy/ssl/kubaca.id/privkey.pem
	redir https://kubaca.id{uri} permanent
}

# ---------- Renderer (public multi-tenant SSR) ----------
# Catch-all :443 untuk custom domain tenant (via on_demand_tls).
# Tenant site = guru's website → butuh Google Fonts + bisa di-iframe di
# dashboard editor preview + bisa di-share link.
# CSP TIDAK boleh terlalu ketat karena setiap guru punya kebutuhan beda
# (mis. embed YouTube, Google Maps, Twitter widget, dll).
:443 {
	tls {
		on_demand
	}

	header {
		-X-Powered-By
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Cross-Origin-Resource-Policy "cross-origin"

		# CSP untuk tenant: permisif untuk image/font/iframe (user bisa embed
		# YouTube/Spotify/Maps), tapi script-src strict ke self + inline
		# (hindari XSS lewat user content). frame-ancestors wildcard supaya
		# preview iframe + sharing bebas.
		# WAJIB Vary: Host supaya downstream cache tidak collapse (middleware
		# Next.js tambah ini juga, double-safe di Caddy level).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.youtube.com https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.kubaca.id https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.google.com; media-src 'self' blob: https:; frame-ancestors *; base-uri 'self'; form-action 'self' https://api.kubaca.id; object-src 'none'; upgrade-insecure-requests"
	}

	# Vary: Host untuk cegah downstream cache cross-tenant leak.
	header Vary Host

	reverse_proxy 10.1.12.46:4001 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}

		transport http {
			dial_timeout 5s
			response_header_timeout 60s
			read_timeout 120s
		}
	}

	log {
		output file /var/log/caddy/renderer-tenant.log {
			roll_size 200mb
			roll_keep 10
		}
	}
}
