{
	# On-demand TLS: ask the API before issuing a cert for an unknown host.
	# Secret is passed as query to prove the request came from Caddy, not from
	# a random caller who reached the API.
	on_demand_tls {
		ask http://api:8080/internal/caddy/ask?secret={$CADDY_ASK_SECRET}
		interval 2m
		burst 5
	}
}

# Snippet CSP header untuk renderer (host user-facing).
# Mengizinkan widget Literaa NFT (cdn.literaa.xyz) + Polygon RPC + Privy/WalletConnect
# untuk login wallet. Snippet dipakai via `import` di tiap host renderer.
(renderer_csp) {
	header Content-Security-Policy "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.literaa.xyz; connect-src 'self' https://literaa.xyz https://cdn.literaa.xyz https://polygon-bor-rpc.publicnode.com https://1rpc.io wss://relay.walletconnect.com wss://relay.walletconnect.org https://api.web3modal.org; img-src 'self' data: blob: https: https://cdn.literaa.xyz https://*.ipfs.dweb.link https://ipfs.io; frame-src 'self' https://verify.walletconnect.com https://verify.walletconnect.org https://*.privy.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com;"
}

# Dashboard / editor — tidak perlu CSP Litera (dashboard tidak embed widget).
app.localhost {
	reverse_proxy web:3000
}

# Public API — tidak perlu CSP (JSON API, bukan HTML yang di-render browser).
api.localhost {
	@cors {
		header Origin *
	}
	reverse_proxy api:8080
}

# Vary: Host mencegah cache downstream (CDN/proxy) menyajikan halaman satu
# tenant ke host lain. Sejak Next 16 ini satu-satunya lapisan: Next menimpa
# Vary dengan daftar RSC-nya, jadi header dari renderer tidak pernah lolos.
(renderer_headers) {
	import renderer_csp
	header Vary Host
}

# Default localhost = renderer (so http://localhost works in dev)
localhost {
	import renderer_headers
	reverse_proxy renderer:3000
}

# Catch-all for any other host (subdomain or custom domain).
# Caddy will call the ask endpoint before issuing TLS.
:443 {
	tls {
		on_demand
	}
	import renderer_headers
	reverse_proxy renderer:3000
}

:80 {
	import renderer_headers
	reverse_proxy renderer:3000
}
