# =============================================================================
# infra/.env — Docker Compose orchestration
# =============================================================================
# File ini di-load otomatis oleh docker compose saat command dijalankan dari
# folder `infra/`. Setiap var di sini di-passthrough ke service via
# docker-compose.yml (semua pakai default sensible kalau kosong).
#
# Setup pertama kali:
#   cd infra && cp .env.example .env
#   docker compose up --build
#
# HANYA berisi var yang di-consume docker-compose.yml. Kalau lihat var yang
# tidak ada di sini tapi ada di apps/api/.env.example, itu berarti flow
# tersebut hanya untuk host-run (`go run ./cmd/server`) — tidak untuk Docker.
#
# Per-app .env untuk mode host-run (bukan Docker):
#   apps/api/.env.example        # Go API
#   apps/web/.env.example        # Next.js dashboard
#   apps/renderer/.env.example   # Next.js renderer
# =============================================================================

# ---- Core ----
APP_ENV=development
LOG_LEVEL=info               # debug | info | warn | error
APP_BASE_URL=http://app.localhost

# ---- Database (postgres service + API pool tuning) ----
POSTGRES_USER=webbuilder
POSTGRES_PASSWORD=webbuilder
POSTGRES_DB=webbuilder
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_SLOW_QUERY_THRESHOLD=500ms

# ---- Object storage (minio service) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- API secrets (WAJIB ganti di production) ----
JWT_SECRET=change-me-in-production-please
CADDY_ASK_SECRET=dev-caddy-secret

# ---- Admin bootstrap (idempotent — user existing tidak di-overwrite) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme1234
ADMIN_NAME=Administrator

# ---- Demo seed (opt-in: insert demo user + UMKM site + sample data) ----
SEED_DEMO=false
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=demo1234

# ---- Storage driver: local | s3 (default s3 → pakai MinIO service) ----
STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=assets
STORAGE_S3_PUBLIC_URL=http://localhost:9000/assets
# Override kalau pakai S3 real (bukan MinIO local). Kalau kosong, ambil
# default dari docker-compose.yml (endpoint minio:9000, credentials =
# MINIO_ROOT_USER/PASSWORD, region us-east-1, non-SSL).
# STORAGE_S3_ENDPOINT=s3.amazonaws.com
# STORAGE_S3_ACCESS_KEY=AKIA...
# STORAGE_S3_SECRET_KEY=...
# STORAGE_S3_REGION=ap-southeast-1
# STORAGE_S3_USE_SSL=true
# Untuk driver=local, override public URL user-facing (default: http://api.localhost/uploads).
# STORAGE_LOCAL_PUBLIC_URL=http://api.localhost/uploads

# ---- Hosts + CORS ----
PUBLIC_APP_HOST=app.localhost
PUBLIC_API_HOST=api.localhost
RENDERER_DEFAULT_HOST=localhost
CORS_ORIGINS=http://localhost:3000,http://app.localhost

# ---- Platform IPs (security: custom-domain verification allowlist) ----
# WAJIB di-set di production. Saat user verifikasi custom domain mereka,
# API cek DNS A record mengarah ke salah satu IP ini. Kalau kosong = mode
# INSECURE (user bisa "claim" domain yang DNS-nya mengarah ke server lain,
# membuka pintu cert ACME abuse).
#
# Juga dipakai auto-attach Cloudflare (A record `@` → PLATFORM_IPS[0]).
# PLATFORM_IPS=1.2.3.4,5.6.7.8

# ---- Image compression (asset upload) ----
IMAGE_COMPRESS_ENABLED=true
IMAGE_MAX_DIMENSION=2000
IMAGE_JPEG_QUALITY=82

# ---- Mail (log = stdout dev, smtp = SMTP relay prod) ----
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Web Builder <no-reply@example.com>
SMTP_STARTTLS=true

# ---- Google OAuth (opsional — isi ketiganya untuk enable) ----
# Kosong = tombol "Login dengan Google" akan 503. Redirect URL harus persis
# sama dengan yang di Google Cloud Console (Authorized redirect URIs).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://api.localhost/api/v1/auth/google/callback

# ---- Registrar API (reseller integration untuk beli domain) ----
# Kosongkan URL = fitur beli domain disabled (tombol otomatis hidden di UI).
# Kalau URL di-set, WAJIB ada API_KEY atau credentials auto-login di bawah.
REGISTRAR_API_URL=
REGISTRAR_API_KEY=
REGISTRAR_API_TIMEOUT=15s

# Auto-login + JWT refresh loop (25d). Recommended production supaya JWT
# (TTL 30d) tidak expire diam-diam.
REGISTRAR_RESELLER_EMAIL=
REGISTRAR_RESELLER_PASSWORD=

# HMAC secret — rotate di admin panel /admin/registrar (dapat sekali,
# paste di sini, restart API).
REGISTRAR_WEBHOOK_SECRET=

# ---- api-registry (Fase 1a — service internal untuk domain lifecycle) ----
# Provider mode: `pandi_wrapper` (proxy ke REGISTRAR_API_URL di atas — MVP)
# atau `epp_direct` (native EPP client — Fase 2, belum tersedia).
API_REGISTRY_PROVIDER_MODE=pandi_wrapper

# HMAC shared secret antara `api` (consumer) dan `api-registry`. Min 32 char
# di production. Generate: openssl rand -hex 32
# Kosong = dev mode (skip auth di kedua sisi).
API_REGISTRY_HMAC_SECRET=

# Webhook forward destination — biasanya endpoint receiver di web builder
# API. Default sudah point ke container `api` di internal network.
API_REGISTRY_WEBHOOK_FORWARD_URL=http://api:8080/internal/registrar/webhook

# Runtime tuning — semaphore inflight EPP + timeout.
API_REGISTRY_REQUEST_TIMEOUT=30s
API_REGISTRY_MAX_CONCURRENT=20

# ---- Observability ----
SENTRY_DSN=
PPROF_ENABLED=false           # admin-only pprof endpoints (heap/CPU)

# ---- Frontend → API URL (dipakai oleh service `web`) ----
NEXT_PUBLIC_API_BASE=http://api.localhost
