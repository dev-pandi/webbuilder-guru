# =============================================================================
# infra/.env — Docker Compose orchestration
# =============================================================================
# Docker Compose membaca file `.env` dari direktori tempat command dijalankan.
# Karena README pakai `cd infra && docker compose up`, file ini berada di sini.
#
# Setup pertama kali:
#   cd infra && cp .env.example .env       # edit secrets di sini
#   docker compose up --build
#
# Untuk DEVELOPMENT TANPA Docker (run service langsung di host),
# pakai file .env per-app:
#   apps/api/.env.example        # config Go API
#   apps/web/.env.example        # config Next.js dashboard
#   apps/renderer/.env.example   # config Next.js renderer
#
# Setiap var di sini di-passthrough ke service via docker-compose.yml.
# =============================================================================

# ---- Postgres (service) ----
POSTGRES_USER=webbuilder
POSTGRES_PASSWORD=webbuilder
POSTGRES_DB=webbuilder

# ---- MinIO (service) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- API secrets (override default insecure values) ----
JWT_SECRET=change-me-in-production-please
CADDY_ASK_SECRET=dev-caddy-secret

# ---- Admin bootstrap (idempotent) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme1234
ADMIN_NAME=Administrator

# ---- Demo seed (opt-in: insert demo user + UMKM site + sample data) ----
SEED_DEMO=false
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=demo1234

# ---- Storage driver (lihat apps/api/.env.example untuk dokumentasi lengkap) ----
STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=assets
STORAGE_S3_PUBLIC_URL=http://localhost:9000/assets

# ---- Public hosts (jarang perlu diubah untuk dev lokal) ----
PUBLIC_APP_HOST=app.localhost
PUBLIC_API_HOST=api.localhost
RENDERER_DEFAULT_HOST=localhost

# ---- Platform IPs (security: domain verification allowlist) ----
# WAJIB di-set di production. Saat user verifikasi custom domain mereka,
# API memastikan DNS A record-nya mengarah ke salah satu IP ini.
# Tanpa ini, user bisa "claim" domain yang DNS-nya menunjuk ke server lain
# (membuka pintu untuk abuse cert ACME issuance).
# Kosongkan di dev = mode INSECURE.
# PLATFORM_IPS=1.2.3.4,5.6.7.8

# ---- Frontend → API URL (dipakai oleh service `web`) ----
NEXT_PUBLIC_API_BASE=http://api.localhost

# ---- Logging ----
LOG_LEVEL=info

# ---- Mail (lihat apps/api/.env.example untuk dokumentasi lengkap) ----
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Web Builder <no-reply@example.com>
SMTP_STARTTLS=true

# ---- Error tracking ----
SENTRY_DSN=

# ---- DB pool ----
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_SLOW_QUERY_THRESHOLD=500ms

# ---- pprof (admin-only debug profiles) ----
PPROF_ENABLED=false

# ---- Image compression (asset upload) ----
IMAGE_COMPRESS_ENABLED=true
IMAGE_MAX_DIMENSION=2000
IMAGE_JPEG_QUALITY=82

# ---- App base URL (untuk link reset password & email verification) ----
APP_BASE_URL=http://app.localhost
