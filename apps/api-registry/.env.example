# === HTTP server ===
PORT=5000
APP_ENV=dev              # dev | staging | prod
LOG_LEVEL=info           # debug | info | warn | error

# === Provider selection ===
# Fase 1: pandi_wrapper (proxy ke registrar-api PANDI existing)
# Fase 2: epp_direct    (native EPP client — belum tersedia)
PROVIDER_MODE=pandi_wrapper

# === Pandi wrapper credentials (WAJIB kalau PROVIDER_MODE=pandi_wrapper) ===
PANDI_API_URL=http://localhost:8080
# Pilih salah satu:
#   Static JWT (rotate manual sebelum 30 hari expire)
PANDI_API_KEY=
#   ATAU email+password (auto-refresh setiap 25 hari)
PANDI_EMAIL=reseller@example.com
PANDI_PASSWORD=changeme
PANDI_API_TIMEOUT=15s

# === EPP direct credentials (Fase 2, belum aktif) ===
EPP_HOST=epp1.pandi.id
EPP_PORT=700
EPP_USER=
EPP_PASSWORD=
EPP_CERT_FILE=/etc/api-registry/epp-client.crt
EPP_KEY_FILE=/etc/api-registry/epp-client.key
EPP_CA_FILE=/etc/api-registry/pandi-ca.crt

# === Internal auth (web builder → api-registry) ===
# HMAC shared secret (min 32 char di prod). Kosong = dev mode (no auth).
# Generate: openssl rand -hex 32
INTERNAL_HMAC_SECRET=

# === Runtime tuning ===
REQUEST_TIMEOUT=30s
MAX_CONCURRENT=20        # limit inflight EPP call (registry session cap)
