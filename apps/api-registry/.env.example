# === HTTP server ===
PORT=5000
APP_ENV=dev              # dev | staging | prod
LOG_LEVEL=info           # debug | info | warn | error

# === Provider selection ===
# Fase 1: pandi_wrapper (proxy ke registrar-api PANDI existing)
# Fase 2: epp_direct    (native EPP client — belum tersedia)
PROVIDER_MODE=pandi_wrapper

# === Pandi wrapper credentials (WAJIB kalau PROVIDER_MODE=pandi_wrapper) ===
PANDI_API_URL=http://localhost:8080
# Pilih salah satu:
#   Static JWT (rotate manual sebelum 30 hari expire)
PANDI_API_KEY=
#   ATAU email+password (auto-refresh setiap 25 hari)
PANDI_EMAIL=reseller@example.com
PANDI_PASSWORD=changeme
PANDI_API_TIMEOUT=15s

# === EPP direct credentials (Fase 2, belum aktif) ===
EPP_HOST=epp1.pandi.id
EPP_PORT=700
EPP_USER=
EPP_PASSWORD=
EPP_CERT_FILE=/etc/api-registry/epp-client.crt
EPP_KEY_FILE=/etc/api-registry/epp-client.key
EPP_CA_FILE=/etc/api-registry/pandi-ca.crt

# === Internal auth (web builder → api-registry) ===
# HMAC shared secret (min 32 char di prod). Kosong = dev mode (no auth).
# Generate: openssl rand -hex 32
INTERNAL_HMAC_SECRET=

# === Runtime tuning ===
REQUEST_TIMEOUT=30s
MAX_CONCURRENT=20        # limit inflight EPP call (registry session cap)

# === Webhook relay (registrar-api → api-registry → web builder) ===
# Verify inbound webhook dari registrar-api. Kalau kosong = dev mode (skip verify).
WEBHOOK_UPSTREAM_SECRET=

# Forward ke web builder. Kalau kosong, api-registry cuma verify + audit
# (tidak forward — cocok untuk staging tanpa web builder yang match).
WEBBUILDER_WEBHOOK_URL=
WEBBUILDER_WEBHOOK_SECRET=
WEBHOOK_FORWARD_TIMEOUT=10s

# === Resilience (retry + circuit breaker) ===
# Kalau upstream (registrar-api / EPP) flaky, kita retry transient error
# (network/5xx/429) + circuit break setelah N consecutive fail supaya tidak
# cascade. Default enabled — set false untuk debug raw upstream behavior.
RESILIENCE_ENABLED=true

# Retry — exponential backoff dengan jitter ±20%.
RETRY_MAX_ATTEMPTS=3          # total attempt (1 initial + 2 retry)
RETRY_INITIAL_DELAY=200ms     # sleep pertama sebelum retry
RETRY_MAX_DELAY=5s            # cap delay antar retry

# Circuit breaker — per-operation (bukan global).
CIRCUIT_FAILURE_THRESHOLD=5   # consecutive transient failure → open
CIRCUIT_COOLDOWN_PERIOD=30s   # durasi open sebelum probe half-open
