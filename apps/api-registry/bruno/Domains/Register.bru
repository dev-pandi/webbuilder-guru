meta {
  name: Register
  type: http
  seq: 4
}

post {
  url: {{base_url}}/v1/domains/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "domain": "example.id",
    "years": 1,
    "external_user_id": "00000000-0000-0000-0000-000000000001",
    "idempotency_key": "test-idem-key-1",
    "contact": {
      "name": "Budi Santoso",
      "email": "budi@example.com",
      "phone": "+62.81234567890",
      "address": "Jl. Sudirman No. 1",
      "city": "Jakarta",
      "state": "DKI Jakarta",
      "postal_code": "10110",
      "country_code": "ID"
    },
    "nameservers": []
  }
}

docs {
  Register domain via EPP domain:create. Sync operation — return
  {job_id, status:"active"} kalau sukses.

  Notes:
  - idempotency_key WAJIB (cegah double-register kalau retry).
  - phone format: E.164 dotted (+CC.NUMBER) — RFC 5733 §2.5.
  - external_user_id dipakai untuk derive contact handle deterministic
    (WB000000...). Cegah dobel contact create per user.
  - Nameservers kosong = pakai default registry (biasanya PANDI hosting).
    Cloudflare auto-attach via web-builder side setelah register sukses.
}

script:pre-request {
  try {
    const crypto = require('crypto');
    const secret = bru.getEnvVar('hmac_secret') || '';
    if (!secret) {
      console.warn('[HMAC] hmac_secret env kosong — skip signing');
      return;
    }
    const ts = Math.floor(Date.now() / 1000).toString();
    const method = req.getMethod().toUpperCase();
    const parsed = new URL(req.getUrl());
    const pathAndQuery = parsed.pathname + parsed.search;
    const rawBody = req.getBody();
    const bodyStr = rawBody
      ? (typeof rawBody === 'string' ? rawBody : JSON.stringify(rawBody))
      : '';
    const canonical = `${ts}.${method}${pathAndQuery}.${bodyStr}`;
    const signature = 'sha256=' + crypto.createHmac('sha256', secret).update(canonical).digest('hex');
    req.setHeader('X-Timestamp', ts);
    req.setHeader('X-Signature', signature);
    console.log('[HMAC] signed', method, pathAndQuery, 'ts=' + ts);
  } catch (err) {
    console.error('[HMAC] error:', err && err.message ? err.message : err);
    throw err;
  }
}
