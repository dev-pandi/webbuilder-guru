meta {
  name: Renew
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/domains/{{domain_name}}/renew
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "period_years": 1,
    "payment_method_code": "deposit_wallet",
    "promo_code": ""
  }
}

docs {
  Perpanjang domain (kind=renew job). Ownership check via
  GetLatestActiveByDomain. UI reuse `/sites/pending/[jobId]` (template
  picker di-skip untuk renew).

  Wallet payment sync (`deposit_wallet`) langsung `active`.
}
