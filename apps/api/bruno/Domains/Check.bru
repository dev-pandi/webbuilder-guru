meta {
  name: Check
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/domains/check
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "domain": "example.id"
  }
}

docs {
  Cek availability via api-registry (EPP check). Response include zone
  flags: `require_document`, `auto_approved` — wizard render field
  KTP/NPWP kalau perlu.

  Response 200:
  ```json
  {
    "data": {
      "available": true,
      "domain": "example.id",
      "zone": { "tld": "id", "require_document": true, "auto_approved": false }
    }
  }
  ```
}
