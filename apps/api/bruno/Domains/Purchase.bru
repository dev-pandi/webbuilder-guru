meta {
  name: Purchase
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/domains/purchase
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "domain": "example.id",
    "period_years": 1,
    "payment_method_code": "midtrans_snap",
    "document_ids": [],
    "promo_code": "",
    "on_behalf_of_client_id": null
  }
}

script:post-response {
  // Capture job_id untuk polling status + retry.
  if (res.status === 200 && res.body && res.body.data && res.body.data.job_id) {
    bru.setEnvVar('job_id', res.body.data.job_id);
  }
  if (res.status === 200 && res.body && res.body.data && res.body.data.invoice_id) {
    bru.setEnvVar('invoice_id', res.body.data.invoice_id);
  }
}

docs {
  Phase 3 self-sufficient purchase. Flow:
    1. Create invoice lokal (draft → unpaid)
    2. Charge via payment gateway (Midtrans/Paylabs/manual_bank/deposit_wallet)
    3. Return `{ job_id, invoice_id, payment_url, status }`
    4. Wallet payment sync → status=`pending_provisioning` langsung
    5. Payment webhook → MarkPaid → ExecuteAfterPayment → EPP CREATE

  `Idempotency-Key` WAJIB (di whitelist CORS) — cegah double-charge kalau
  user click twice.

  `on_behalf_of_client_id` — hanya untuk role reseller/agent, dengan
  active assignment ke client. Handler validate via CanRegisterForClient +
  HasActiveAssignment.

  `document_ids[]` — dari `POST /documents` upload (kalau zone
  require_document, mis. .id).
}
