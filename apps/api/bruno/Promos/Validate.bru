meta {
  name: Validate
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/promos/validate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "code": "PROMO2026",
    "domain": "example.id",
    "period_years": 1,
    "kind": "register"
  }
}

docs {
  Preview discount tanpa redeem. Cek:
    - Code exist + status=active
    - Applies_to: register | renew | both
    - TLD whitelist
    - Min subtotal
    - Max uses total + per-user
    - Valid window (`valid_from` <= now < `valid_until`)

  Response: `{ discount_amount, subtotal_after_discount }`.

  Redemption actual terjadi saat purchase — tracked di `promo_redemptions`
  (unique per `invoice_id`).
}
