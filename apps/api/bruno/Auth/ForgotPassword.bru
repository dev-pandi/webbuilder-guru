meta {
  name: ForgotPassword
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/auth/password/forgot
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{user_email}}"
  }
}

docs {
  Always return 200 supaya tidak leak email enumeration. Kalau email valid,
  reset token dikirim via email. IP-limited (passwordForgotPerWindow).
}
