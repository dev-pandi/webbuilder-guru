meta {
  name: UpdateMe
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/api/v1/auth/me
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Nama Baru",
    "phone": "+6281234567890",
    "address": "Jl. Contoh No. 1",
    "city": "Jakarta",
    "postal_code": "12345",
    "national_id": "3171012345678901"
  }
}

docs {
  PATCH profile — semua field opsional (COALESCE di SQL). Email + password
  tidak bisa di-update di sini (endpoint terpisah).

  `national_id` (NIK) wajib untuk register domain .id (zone.require_document).
}
