meta {
  name: ResetPassword
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/auth/password/reset
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "reset-token-from-email",
    "password": "newpassword123"
  }
}

docs {
  Set password baru pakai token dari email. Token single-use — dihapus
  setelah sukses. Password minimum 8 char.
}
