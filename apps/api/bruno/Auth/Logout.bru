meta {
  name: Logout
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/auth/logout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

docs {
  Revoke refresh token — access token tetap valid sampai expire (15m).
  Idempotent: revoke ulang no-op.
}
