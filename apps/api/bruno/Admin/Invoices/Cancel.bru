meta {
  name: Cancel
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/admin/invoices/{{invoice_id}}/cancel
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "User request cancel"
  }
}

docs {
  Cancel invoice `unpaid`. Kalau sudah paid, harus refund via wallet
  adjust manual (`POST /admin/wallet/adjust`).
}
