meta {
  name: UpdateQuota
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/api/v1/admin/sites/:id/quota
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "quota_max_pages": 50,
    "quota_max_storage_bytes": 524288000
  }
}

docs {
  Admin ubah quota per situs. Default: 20 pages, 100 MB storage.
}
