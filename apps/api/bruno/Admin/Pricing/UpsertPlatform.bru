meta {
  name: UpsertPlatform
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/admin/pricing/platform
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tld": "id",
    "period_years": 1,
    "cost_cents": 15000000,
    "retail_cents": 25000000,
    "wholesale_cents": 20000000
  }
}

docs {
  Set cost + retail + wholesale (Rp cents) per TLD + period. Upsert by
  `(tld, period_years)`.
}
