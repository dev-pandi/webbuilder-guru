script:pre-request {
  // Auto-attach Authorization: Bearer <access_token> untuk semua request
  // JWT-protected. Skip endpoint anonymous supaya tidak leak token accidental.
  //
  // Anonymous / infra endpoints yang SKIP:
  //   /healthz, /livez, /readyz, /metrics, /public/*, /webhooks/*,
  //   /internal/*, /uploads/*, /auth/login, /auth/register, /auth/refresh,
  //   /auth/logout, /auth/password/*, /auth/email/verify, /auth/reseller/apply,
  //   /invitations/:token (GET/POST accept)
  const url = req.getUrl();
  const path = new URL(url).pathname;

  const anonymousPatterns = [
    /^\/$/,
    /^\/healthz(\/|$)/,
    /^\/livez(\/|$)/,
    /^\/readyz(\/|$)/,
    /^\/metrics(\/|$)/,
    /^\/public\//,
    /^\/webhooks\//,
    /^\/internal\//,
    /^\/uploads\//,
    /^\/api\/v1\/auth\/(login|register|refresh|logout|reseller\/apply)$/,
    /^\/api\/v1\/auth\/password\//,
    /^\/api\/v1\/auth\/email\/verify$/,
    /^\/api\/v1\/auth\/google\//,
    /^\/api\/v1\/invitations\//,
    // Templates list + meta + get by slug — anonymous per router/user.go
    /^\/api\/v1\/templates(\/|$)/,
    /^\/api\/v1\/template-meta$/,
  ];
  if (anonymousPatterns.some(re => re.test(path))) return;

  const token = bru.getEnvVar('access_token') || '';
  if (token) {
    req.setHeader('Authorization', 'Bearer ' + token);
  }
}
