meta {
  name: UpsertPricing
  type: http
  seq: 9
}

post {
  url: {{base_url}}/api/v1/reseller/pricing
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tld": "id",
    "period_years": 1,
    "retail_price_cents": 25000000
  }
}

docs {
  Reseller-only. Set markup retail per TLD + period. TLD di-whitelist ke
  yang exist di `platform_prices` (via `/reseller/pricing/platform-tlds`).
}
