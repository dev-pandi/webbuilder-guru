meta {
  name: Update
  type: http
  seq: 3
}

patch {
  url: {{base_url}}/api/v1/sites/{{site_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Nama Situs Baru",
    "slug": "nama-baru",
    "theme_tokens": {
      "colors": { "primary": "#3b82f6" },
      "fonts": { "heading": "Inter", "body": "Inter" },
      "radius": "0.5rem"
    }
  }
}

docs {
  Semua field opsional (COALESCE). Slug harus unique per user. Theme
  tokens diinject sebagai CSS variables di renderer.
}
