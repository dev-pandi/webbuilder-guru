# =============================================================================
# apps/renderer — Next.js Multi-tenant Renderer (situs publik user)
# =============================================================================
# Dipakai saat development langsung di host:
#   cd apps/renderer && cp .env.example .env.local && npm run dev -- -p 3001
#
# Renderer adalah server component yang baca data dari API → bukan dari browser.
# Jadi URL di sini adalah SERVER-TO-SERVER, bukan client-side.
# =============================================================================

# URL internal ke API (server-to-server fetch).
# - Docker Compose: http://api:8080   (service name di compose network)
# - Lokal w/o compose: http://localhost:8080
NODE_ENV=development
API_INTERNAL_URL=http://localhost:8080

# Set true supaya setiap backend fetch log ke stderr renderer:
#   [fetch] 200 GET /public/site-by-host?host=foo 12ms attempt=1 cache=no-store host=foo
# Dipakai untuk verifikasi "apakah renderer benar-benar hit backend".
# 404/5xx selalu di-log (walau flag false). Default false.
RENDERER_FETCH_DEBUG=false

# URL public API (client-side, browser fetch). Dipakai untuk analytics beacon
# (setiap pageload POST hit) + form submissions dari sisi browser. Kosongkan
# untuk skip beacon diam-diam (dev tanpa API publik OK).
# Prod: https://api.your-platform.com (Caddy proxy ke API container)
NEXT_PUBLIC_API_BASE=http://api.localhost
