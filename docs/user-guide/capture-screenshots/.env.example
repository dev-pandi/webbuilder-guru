# Copy ke .env dan isi sesuai environment Anda.
#
# WAJIB: 4 akun test dengan role sesuai (buat via /admin/users dulu)
# Recommended: pakai staging environment biar tidak polute production data

# ---------- URLs ----------
# Frontend
BASE_URL=http://localhost:3000

# API (auto-derive kalau kosong: BASE_URL:8080 untuk localhost, atau api.<host>)
# API_BASE=http://localhost:8080

# ---------- Test Accounts ----------
# Setiap akun harus pre-existing di DB dengan role yang benar.
# Recommended password: unique per environment, min 12 char.

CLIENT_EMAIL=client-test@example.com
CLIENT_PASSWORD=ChangeMe123!

AGENT_EMAIL=agent-test@example.com
AGENT_PASSWORD=ChangeMe123!

RESELLER_EMAIL=reseller-test@example.com
RESELLER_PASSWORD=ChangeMe123!

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---------- Sample Data IDs (opsional) ----------
# Hardcode kalau mau konsisten setiap run. Kalau kosong, script auto-discover
# dari list (pilih row pertama).

# Site ID (UUID) — untuk capture editor + theme page
# SAMPLE_SITE_ID=

# Domain (FQDN) — untuk capture domain detail page
# SAMPLE_DOMAIN=

# Client ID (UUID) — untuk capture agent/reseller OBO flow
# SAMPLE_CLIENT_ID=
